<section>
  <h1>
    <img src="/burger.svg" alt="Burger Demo" />
  </h1>
  <ul id="burger-list"></ul>
</section>

<style>
  section {
    overflow: auto;
    max-height: 100%;
  }

  h1 img {
    max-width: 60px;
    margin-left: var(--spacing-list-padding);
    margin-top: calc(var(--spacing-list-padding) / 2);
  }

  #burger-list {
    list-style: none;
    margin: 0;
    padding: 0.75rem 0;
    padding-block: var(--spacing-list-padding);

    h2 {
      font-size: 2rem;
      margin: 0;
    }

    li {
      margin-inline: var(--spacing-list-padding);
      padding-block: 3rem;
      position: relative;
      border-bottom: 2px solid var(--color-muted-blue);

      &:first-child {
        padding-top: 0;
      }

      &:last-child {
        border-bottom: none;
        padding-bottom: 0;
      }

      &.active:before {
        content: "";
        position: absolute;
        top: 3rem;
        left: calc(-1 * var(--spacing-list-padding));
        width: 1rem;
        height: calc(100% - 6rem);
        background-color: var(--color-accent-blue);
        border-top-right-radius: 0.5rem;
        border-bottom-right-radius: 0.5rem;
        z-index: 1;
      }

      &.active:first-child:before {
        top: 0rem;
        height: calc(100% - 3rem);
      }

      path {
        fill: var(--color-secondary-blue);
      }

      button {
        background: unset;
        border: none;
        width: 100%;
        text-align: left;
        color: var(--color-main-text);
        cursor: pointer;
        padding: 0;
        margin-bottom: 1rem;

        &:hover,
        &:focus-visible {
          outline: none;
          color: var(--color-accent-blue);
        }
      }

      a {
        text-decoration: none;
        color: var(--color-main-text);

        &:hover,
        &:focus-visible {
          outline: none;
          color: var(--color-accent-blue);
        }
      }

      .description {
        margin: 0 0 1rem 0;
        font-size: 1.125rem;
        line-height: 1.55;
      }

      .attribute {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        margin-block: 0.5rem;
        font-size: 1.125rem;
        line-height: 1.55;
      }
    }
  }
</style>

<script>
  import type { Burger } from "@minnebar-2025/burgers";
  import { SOUPS_ON_EVENT } from "../constants/SOUPS_ON_EVENT";
  import { createListItem } from "../scripts/createListItem";

  document.addEventListener(
    SOUPS_ON_EVENT,
    (event) => {
      const { burgers } = (event as CustomEvent).detail;

      const burgerList = document.getElementById("burger-list")!;

      (burgers as Burger[]).forEach((burger) => {
        const listItem = createListItem(burger);
        burgerList.appendChild(listItem);
      });
    },
    { once: true }
  );
</script>
