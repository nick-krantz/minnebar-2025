---
import BurgerList from "../components/BurgerList.astro";
import BurgerMap from "../components/BurgerMap.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main>
    <BurgerList />
    <BurgerMap />
  </main>
</Layout>

<style>
  main {
    display: grid;
    grid-template-columns: 33% 67%;
    grid-template-rows: 100dvh;
  }
</style>

<script>
  import type { Burger } from "@minnebar-2025/burgers";
  import { API_URL } from "astro:env/client";
  import { SOUPS_ON_EVENT } from "../constants/SOUPS_ON_EVENT";

  fetch(`${API_URL}/api/burgers`)
    .then((response) => response.json())
    .then((burgers: Burger[]) => {
      const event = new CustomEvent(SOUPS_ON_EVENT, {
        detail: { burgers },
      });
      document.dispatchEvent(event);
    })
    .catch((error) => {
      console.error("Error fetching data:", error);
    });
</script>
